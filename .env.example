# Local four-button demo (backend :8000) — not production auth.
OMNIGUARD_API_URL=http://127.0.0.1:8000
OMNIGUARD_DEMO_TOKEN=fleet-agent-valid-token
OMNIGUARD_SIMULATOR_TOKEN=omniguard-sim
OMNIGUARD_AI_ENFORCE=true

# Optional LLM explanation (never commit real keys)
LLM_PROVIDER=fallback
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=bedrock
# BEDROCK_MODEL_ID=
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
AWS_REGION=ap-south-1

# Isaac push (use scripts/run_isaac_services.sh — not run_demo.sh)
# OMNIGUARD_ROBOT_BACKEND=isaac
# ISAAC_BRIDGE_URL=http://127.0.0.1:8899
# ISAAC_BRIDGE_HOST=127.0.0.1
# ISAAC_BRIDGE_TOKEN=omniguard-bridge

# JWT broker (:8001)
# OMNIGUARD_JWT_SECRET=replace-with-32+-byte-secret
# BROKER_URL=http://127.0.0.1:8001
