# Local four-button demo (backend :8000) — not production auth.
OMNIGUARD_API_URL=http://127.0.0.1:8000
OMNIGUARD_DEMO_TOKEN=fleet-agent-valid-token
OMNIGUARD_SIMULATOR_TOKEN=omniguard-sim
OMNIGUARD_OPERATOR_TOKEN=omniguard-operator
OMNIGUARD_AI_ENFORCE=true

# Optional LLM explanation (never commit real keys — .env is gitignored)
LLM_PROVIDER=fallback

# OmniGuard hackathon OpenRouter — set the real key only in local .env on the machine:
#   cp .env.example .env
#   then fill OPENROUTER_API_KEY=...
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=REPLACE_ME_ON_MACHINE_DO_NOT_COMMIT
# OPENROUTER_MODEL=anthropic.claude-sonnet-4-6
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Other allowed models (optional):
# OPENROUTER_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
# OPENROUTER_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0
# OPENROUTER_MODEL=anthropic.claude-sonnet-5
# OPENROUTER_MODEL=anthropic.claude-opus-5
# OPENROUTER_MODEL=openai.gpt-5.6-sol

# Direct OpenAI / Bedrock / Anthropic (optional alternatives):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=bedrock
# BEDROCK_MODEL_ID=
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
AWS_REGION=ap-south-1

# Isaac push (use scripts/run_isaac_services.sh — not run_demo.sh)
# OMNIGUARD_ROBOT_BACKEND=isaac
# ISAAC_BRIDGE_URL=http://127.0.0.1:8899
# Optional Isaac 6.0.1 mobile-manipulator overrides (GPU host only)
# Default: wheeled Clearpath Ridgeback + Franka arm/end-effector.
# OMNIGUARD_MOBILE_MANIPULATOR_USD=/Isaac/Robots/Clearpath/RidgebackFranka/ridgeback_franka.usd
# Alternative visual match: /Isaac/Robots/Clearpath/RidgebackUr/ridgeback_ur5.usd
# Legacy custom composite fallback only:
# OMNIGUARD_USE_COMPOSITE_MOBILE_MANIPULATOR=false
# OMNIGUARD_IWHUB_USD=/Isaac/Robots/Idealworks/iwhub/iw_hub.usd
# OMNIGUARD_UR10E_USD=/Isaac/Robots/UniversalRobots/ur10e/ur10e.usd
# OMNIGUARD_ROBOTIQ_2F140_USD=/Isaac/Robots/Robotiq/2F-140/Robotiq_2F_140_config.usd
# OMNIGUARD_IWHUB_ARM_MOUNT=base_link
# OMNIGUARD_UR10E_BASE_MOUNT=base_link
# OMNIGUARD_UR10E_TOOL_MOUNT=ee_link
# OMNIGUARD_ROBOTIQ_BASE_MOUNT=robotiq_base_link
# OMNIGUARD_ARM_MOUNT_TRANSLATION=0,0,0.62
# OMNIGUARD_ARM_MOUNT_ROTATION_DEGREES=0,0,0
# OMNIGUARD_GRIPPER_MOUNT_TRANSLATION=0,0,0
# OMNIGUARD_GRIPPER_MOUNT_ROTATION_DEGREES=0,0,0
# OMNIGUARD_UR10E_STOW_DEGREES=0,-90,90,-90,-90,0

# JWT broker (:8001)
# OMNIGUARD_JWT_SECRET=replace-with-32+-byte-secret
# BROKER_URL=http://127.0.0.1:8001
