# Local four-button demo (backend :8000) — not production auth.
OMNIGUARD_API_URL=http://127.0.0.1:8000
OMNIGUARD_DEMO_TOKEN=fleet-agent-valid-token
OMNIGUARD_SIMULATOR_TOKEN=omniguard-sim
OMNIGUARD_AI_ENFORCE=true

# Optional LLM explanation (never commit real keys)
LLM_PROVIDER=fallback
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=bedrock
# BEDROCK_MODEL_ID=
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
AWS_REGION=ap-south-1

# Isaac push (use scripts/run_isaac_services.sh — not run_demo.sh)
# OMNIGUARD_ROBOT_BACKEND=isaac
# ISAAC_BRIDGE_URL=http://127.0.0.1:8899
# Optional Isaac 6.0.1 mobile-manipulator overrides (GPU host only)
# OMNIGUARD_IWHUB_USD=/Isaac/Robots/Idealworks/iwhub/iw_hub.usd
# OMNIGUARD_UR10E_USD=/Isaac/Robots/UniversalRobots/ur10e/ur10e.usd
# OMNIGUARD_ROBOTIQ_2F140_USD=/Isaac/Robots/Robotiq/2F-140/Robotiq_2F_140_config.usd
# OMNIGUARD_IWHUB_ARM_MOUNT=base_link
# OMNIGUARD_UR10E_BASE_MOUNT=base_link
# OMNIGUARD_UR10E_TOOL_MOUNT=ee_link
# OMNIGUARD_ROBOTIQ_BASE_MOUNT=robotiq_base_link
# OMNIGUARD_ARM_MOUNT_TRANSLATION=0,0,0.62
# OMNIGUARD_ARM_MOUNT_ROTATION_DEGREES=0,0,0
# OMNIGUARD_GRIPPER_MOUNT_TRANSLATION=0,0,0
# OMNIGUARD_GRIPPER_MOUNT_ROTATION_DEGREES=0,0,0
# OMNIGUARD_UR10E_STOW_DEGREES=0,-90,90,-90,-90,0

# JWT broker (:8001)
# OMNIGUARD_JWT_SECRET=replace-with-32+-byte-secret
# BROKER_URL=http://127.0.0.1:8001
