aws_region   = "ap-south-1"
project_name = "omniguard"
instance_type = "g6e.4xlarge"
root_volume_gb = 1024

# REQUIRED: your public IP(s) as /32 — never leave this open to the world for DCV/WebRTC
allowed_cidr_blocks = [
  "203.0.113.10/32"
]

# Optional: expose OmniGuard broker remotely (prefer running clients on the GPU box)
# extra_tcp_ports = [8000]

# Key pair — choose ONE approach:
create_key_pair = true
# key_name        = "my-existing-key"
# public_key_path = "~/.ssh/id_rsa.pub"

# Leave empty to auto-discover Marketplace AMI after you Accept Terms
ami_id = ""
# ami_id = "ami-xxxxxxxxxxxxxxxxx"

associate_elastic_ip = true
use_default_vpc      = true
